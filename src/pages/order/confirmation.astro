---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config";

const waDigits = site.whatsapp.replace(/\D/g, "");
---

<BaseLayout title="Order received" description="Thank you for your order." noindex>
  <section class="container-page py-24 md:py-32">
    <div class="mx-auto max-w-xl text-center">
      <!-- Icon and wording are swapped by the script below: a manual-UPI order
           is "received, payment being verified", never "confirmed". -->
      <div
        id="order-mark"
        class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border-2 border-champagne text-champagne"
      >
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M5 13l4 4L19 7"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>

      <p class="eyebrow mt-8">Thank you</p>
      <h1 id="order-heading" class="mt-3 font-serif text-4xl md:text-5xl">
        Your order is received
      </h1>

      <p id="order-lede" class="mt-5 text-charcoal/70">
        We've received your order and emailed your details. Your reference is:
      </p>
      <p
        id="order-ref"
        class="mt-3 inline-block border hairline bg-bone/50 px-5 py-2 font-serif text-xl tracking-wide"
      >
        —
      </p>

      <div
        id="order-verify"
        class="mx-auto mt-8 hidden max-w-md border-l-2 border-champagne bg-champagne/5 px-4 py-3 text-left text-sm leading-relaxed text-charcoal/70"
      >
        <strong class="text-charcoal">Your payment is being verified.</strong> We're matching the
        UPI reference you sent against our account. Your pieces are held for you in the meantime.
        You'll get an email as soon as the payment is confirmed — and if we can't find it, we'll
        email you that too and release the order. Nothing is dispatched until then.
      </div>

      <p class="mt-8 text-sm leading-relaxed text-charcoal/65">
        Keep this reference for any questions about your order. We'll be in touch
        with shipping updates. Need help?{" "}
        <a
          href={`https://wa.me/${waDigits}`}
          target="_blank"
          rel="noopener"
          class="link-underline text-champagne">Message us on WhatsApp</a
        >.
      </p>

      <div class="mt-10">
        <a href="/shop" class="btn btn-primary">Continue shopping</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // The order reference and its status are passed by the checkout island.
  const params = new URLSearchParams(location.search);
  const ref = params.get("ref");
  const status = params.get("status");

  const el = document.getElementById("order-ref");
  if (el) el.textContent = ref || "your emailed confirmation";

  if (status === "awaiting_payment") {
    document.getElementById("order-verify")?.classList.remove("hidden");
    const lede = document.getElementById("order-lede");
    if (lede)
      lede.textContent =
        "We've recorded your order and your payment reference. Your reference is:";
    // A clock, not a tick — nothing has been confirmed yet.
    const mark = document.getElementById("order-mark");
    if (mark)
      mark.innerHTML =
        '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
        '<circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"></circle>' +
        '<path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>' +
        "</svg>";
  } else if (status === "cod_pending") {
    const heading = document.getElementById("order-heading");
    if (heading) heading.textContent = "Your order is confirmed";
  }
</script>
