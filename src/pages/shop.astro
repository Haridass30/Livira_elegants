---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatINR } from "../lib/format";

const productEntries = await getCollection("products");
const catEntries = (await getCollection("categories")).map((c) => c.data);

// API-shaped product data — the single source used for SSR, the embedded JSON
// the client renders from, and (after refresh) the live /api/products payload.
const shopProducts = productEntries.map((e) => {
  const d = e.data;
  return {
    slug: d.slug,
    name: d.name,
    price: d.price,
    compareAtPrice: d.compareAtPrice ?? null,
    category: d.category,
    inStock: d.inStock,
    featured: d.featured,
    createdAt: d.createdAt ?? "",
    images: (d.images ?? []).map((i) => ({
      id: Number(String(i.url).split("/").pop()),
      width: i.width,
      height: i.height,
    })),
  };
});
const shopCats = catEntries.map((c) => ({
  name: c.name,
  parent: c.parent ?? null,
  position: c.position,
}));

const byName = new Map(shopCats.map((c) => [c.name, c]));
const mainOf = (leaf: string) => {
  const c = byName.get(leaf);
  return c ? (c.parent ?? c.name) : leaf;
};
const isSub = (name: string) => {
  const c = byName.get(name);
  return !!(c && c.parent);
};
const leaves = new Set(shopProducts.map((p) => p.category));
const present = new Set(shopProducts.map((p) => mainOf(p.category)));

const knownMains = shopCats
  .filter((c) => !c.parent && present.has(c.name))
  .sort((a, b) => a.position - b.position)
  .map((c) => c.name);
const unknownMains = [...present].filter((n) => !byName.has(n)).sort((a, b) => a.localeCompare(b));
const mainNames = [...knownMains, ...unknownMains];

const countFor = (cat: string) =>
  cat === "all"
    ? shopProducts.length
    : isSub(cat)
      ? shopProducts.filter((p) => p.category === cat).length
      : shopProducts.filter((p) => mainOf(p.category) === cat).length;

// Sidebar model: each main with its populated sub-categories, all with counts.
const sidebar = mainNames.map((m) => ({
  name: m,
  count: countFor(m),
  subs: shopCats
    .filter((s) => s.parent === m && leaves.has(s.name))
    .sort((a, b) => a.position - b.position)
    .map((s) => ({ name: s.name, count: countFor(s.name) })),
}));

const PER_PAGE = 12;
const featuredCmp = (a: (typeof shopProducts)[number], b: (typeof shopProducts)[number]) =>
  ((a.inStock ? 0 : 2) + (a.featured ? -1 : 0)) - ((b.inStock ? 0 : 2) + (b.featured ? -1 : 0)) ||
  a.name.localeCompare(b.name);

const totalCount = shopProducts.length;
const initial = [...shopProducts].sort(featuredCmp).slice(0, PER_PAGE);
const shownTo = Math.min(PER_PAGE, totalCount);
const totalPages = Math.ceil(totalCount / PER_PAGE);

const embed = JSON.stringify({ products: shopProducts, cats: shopCats }).replace(/</g, "\\u003c");
---

<BaseLayout
  title="Shop"
  description="The full Livira collection — rings, necklaces, earrings and bangles, handcrafted in India."
>
  <section class="container-page py-10 md:py-14">
    <header class="text-center">
      <p class="eyebrow flex items-center justify-center gap-2">
        <span class="gem-mark">◆</span> Shop our collection
      </p>
      <h1 class="mt-3 font-serif text-4xl md:text-5xl">Shop all</h1>
    </header>

    <div class="mt-10 grid gap-8 lg:grid-cols-[220px_1fr] lg:gap-12">
      <!-- Sidebar: category filters -->
      <aside id="shop-sidebar" class="hidden lg:block">
        <div class="lg:sticky lg:top-28">
          <div class="flex items-center justify-between border-b hairline pb-3">
            <h2 class="font-serif text-lg">Categories</h2>
            <button type="button" id="sidebar-close" class="text-charcoal/50 lg:hidden" aria-label="Close filters">✕</button>
          </div>
          <ul id="cat-list" class="mt-4 space-y-1 text-sm">
            <li>
              <button type="button" class="cat-link" data-cat="all" data-active="true">
                <span>All</span><span class="text-charcoal/40">{totalCount}</span>
              </button>
            </li>
            {
              sidebar.map((m) => (
                <li>
                  <button type="button" class="cat-link" data-cat={m.name}>
                    <span>{m.name}</span><span class="text-charcoal/40">{m.count}</span>
                  </button>
                  {m.subs.length > 0 && (
                    <ul class="ml-3 border-l hairline pl-3">
                      {m.subs.map((s) => (
                        <li>
                          <button type="button" class="cat-link cat-sub" data-cat={s.name}>
                            <span>{s.name}</span><span class="text-charcoal/40">{s.count}</span>
                          </button>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </aside>

      <!-- Main column -->
      <div>
        <!-- Toolbar -->
        <div class="flex flex-col gap-3 border-b hairline pb-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            <button type="button" id="filter-toggle" class="btn btn-outline !px-4 !py-2 !text-xs lg:hidden">
              ☰ Filters
            </button>
            <p id="result-count" class="text-sm text-charcoal/60">
              Showing 1–{shownTo} of {totalCount} results
            </p>
          </div>
          <label class="flex items-center gap-3 text-xs uppercase tracking-[0.12em] text-charcoal/60">
            Sort by
            <select
              id="sort"
              class="border hairline bg-ivory px-3 py-2 text-charcoal outline-none focus:border-champagne"
            >
              <option value="featured">Featured</option>
              <option value="newest">Newest</option>
              <option value="price-asc">Price: low to high</option>
              <option value="price-desc">Price: high to low</option>
              <option value="name">Name: A–Z</option>
            </select>
          </label>
        </div>

        <!-- Grid -->
        <div
          id="product-grid"
          class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 md:grid-cols-3 md:gap-x-8"
        >
          {
            initial.map((p, i) => {
              const onSale = p.compareAtPrice && p.compareAtPrice > p.price;
              const disc = onSale
                ? Math.round(((p.compareAtPrice! - p.price) / p.compareAtPrice!) * 100)
                : 0;
              const img = p.images[0];
              const hov = p.images[1];
              const imgUrl = img ? `/api/images/${img.id}` : "";
              return (
                <article
                  class="shop-card group flex flex-col"
                  data-category={p.category}
                  data-main={mainOf(p.category)}
                >
                  <a href={`/product/${p.slug}`} class="block">
                    <div class="card-lux relative overflow-hidden rounded-[3px]" style="aspect-ratio:4 / 5;">
                      {img && (
                        <img
                          src={imgUrl}
                          width={img.width}
                          height={img.height}
                          alt={p.name}
                          loading={i < 6 ? "eager" : "lazy"}
                          class:list={[
                            "h-full w-full object-cover transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.05]",
                            hov && "group-hover:opacity-0",
                          ]}
                        />
                      )}
                      {hov && (
                        <img
                          src={`/api/images/${hov.id}`}
                          width={hov.width}
                          height={hov.height}
                          alt=""
                          aria-hidden="true"
                          loading="lazy"
                          class="absolute inset-0 h-full w-full scale-[1.05] object-cover opacity-0 transition-opacity duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:opacity-100"
                        />
                      )}
                      {onSale && p.inStock && <span class="pill absolute left-3 top-3">−{disc}%</span>}
                      {!p.inStock && <span class="pill absolute left-3 top-3 !text-charcoal/80">Sold out</span>}
                    </div>
                  </a>
                  <div class="mt-3 flex flex-1 flex-col text-center">
                    <p class="text-[10px] uppercase tracking-[0.18em] text-champagne/80">{p.category}</p>
                    <a href={`/product/${p.slug}`} class="mt-1 font-serif text-base leading-snug hover:text-ink">
                      {p.name}
                    </a>
                    <p class="mt-1 flex items-baseline justify-center gap-2 text-sm">
                      <span class="text-champagne">{formatINR(p.price)}</span>
                      {onSale && <span class="text-charcoal/40 line-through">{formatINR(p.compareAtPrice!)}</span>}
                    </p>
                    <div class="mt-3">
                      {p.inStock ? (
                        <button
                          type="button"
                          class="add-to-bag btn btn-primary w-full !py-2.5 !text-[0.7rem]"
                          data-slug={p.slug}
                          data-name={p.name}
                          data-price={p.price}
                          data-image={imgUrl}
                        >
                          Add to bag
                        </button>
                      ) : (
                        <button type="button" class="btn btn-primary w-full !py-2.5 !text-[0.7rem]" disabled>
                          Sold out
                        </button>
                      )}
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>

        <p id="empty-state" class="hidden py-20 text-center text-charcoal/55">
          No pieces in this category yet.
        </p>

        <nav id="pagination" class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
          {
            totalPages > 1 &&
              Array.from({ length: totalPages }, (_, i) => (
                <button type="button" class="page-btn" data-page={i + 1} data-active={i === 0 ? "true" : "false"}>
                  {i + 1}
                </button>
              ))
          }
        </nav>
      </div>
    </div>
  </section>

  <div id="shop-data" data-embed={embed} hidden></div>
</BaseLayout>

<style>
  .cat-link {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem;
    border-radius: 2px;
    color: color-mix(in srgb, var(--color-charcoal) 78%, transparent);
    transition: background-color 0.2s var(--ease-soft), color 0.2s var(--ease-soft);
    text-align: left;
  }
  .cat-link:hover {
    background: var(--color-bone);
    color: var(--color-charcoal);
  }
  .cat-link[data-active="true"] {
    color: var(--color-champagne);
    font-weight: 600;
  }
  .cat-sub {
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-charcoal) 62%, transparent);
  }
  .page-btn {
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-champagne) 30%, transparent);
    border-radius: 2px;
    font-size: 0.85rem;
    color: var(--color-charcoal);
    transition: all 0.2s var(--ease-soft);
  }
  .page-btn:hover {
    border-color: var(--color-champagne);
  }
  .page-btn[data-active="true"] {
    background: var(--color-charcoal);
    color: var(--color-ivory);
    border-color: var(--color-charcoal);
  }
  /* Mobile: sidebar shown as a panel when toggled. */
  @media (max-width: 1023px) {
    #shop-sidebar.is-open {
      display: block;
      margin-bottom: 1.5rem;
      border: 1px solid color-mix(in srgb, var(--color-champagne) 22%, transparent);
      border-radius: 3px;
      padding: 1rem;
    }
  }
</style>

<script>
  import { addToCart } from "../stores/cart";
  import { formatINR } from "../lib/format";

  const grid = document.getElementById("product-grid")!;
  const sidebar = document.getElementById("shop-sidebar")!;
  const catList = document.getElementById("cat-list")!;
  const sortSel = document.getElementById("sort") as HTMLSelectElement;
  const empty = document.getElementById("empty-state")!;
  const resultCount = document.getElementById("result-count")!;
  const pagination = document.getElementById("pagination")!;
  const filterToggle = document.getElementById("filter-toggle");
  const dataEl = document.getElementById("shop-data")!;

  const PER_PAGE = 12;
  const esc = (s: unknown) =>
    String(s ?? "").replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string,
    );

  type P = {
    slug: string; name: string; price: number; compareAtPrice: number | null;
    category: string; inStock: boolean; featured: boolean; createdAt: string;
    images: { id: number; width: number; height: number }[];
  };
  type C = { name: string; parent: string | null; position: number };

  let data: { products: P[]; cats: C[] } = { products: [], cats: [] };
  try {
    data = JSON.parse(dataEl.dataset.embed || '{"products":[],"cats":[]}');
  } catch {}

  let cat = "all";
  let sort = "featured";
  let page = 1;
  let firstPaint = true; // keep the server-rendered grid on the very first render

  const byName = () => new Map(data.cats.map((c) => [c.name, c]));
  const mainOf = (leaf: string, m = byName()) => {
    const c = m.get(leaf);
    return c ? (c.parent ?? c.name) : leaf;
  };
  const isSub = (name: string, m = byName()) => {
    const c = m.get(name);
    return !!(c && c.parent);
  };

  function filtered(): P[] {
    const m = byName();
    let list = data.products;
    if (cat !== "all") {
      list = isSub(cat, m)
        ? list.filter((p) => p.category === cat)
        : list.filter((p) => mainOf(p.category, m) === cat);
    }
    const arr = [...list];
    switch (sort) {
      case "price-asc": arr.sort((a, b) => a.price - b.price); break;
      case "price-desc": arr.sort((a, b) => b.price - a.price); break;
      case "name": arr.sort((a, b) => a.name.localeCompare(b.name)); break;
      case "newest": arr.sort((a, b) => (b.createdAt || "").localeCompare(a.createdAt || "")); break;
      default:
        arr.sort((a, b) =>
          ((a.inStock ? 0 : 2) + (a.featured ? -1 : 0)) - ((b.inStock ? 0 : 2) + (b.featured ? -1 : 0)) ||
          a.name.localeCompare(b.name));
    }
    return arr;
  }

  function cardHTML(p: P, i: number): string {
    const onSale = p.compareAtPrice && p.compareAtPrice > p.price;
    const disc = onSale ? Math.round(((p.compareAtPrice! - p.price) / p.compareAtPrice!) * 100) : 0;
    const img = p.images[0];
    const hov = p.images[1];
    const url = img ? `/api/images/${img.id}` : "";
    const m = byName();
    const base = img
      ? `<img src="${url}" width="${img.width}" height="${img.height}" alt="${esc(p.name)}" loading="${i < 6 ? "eager" : "lazy"}" class="h-full w-full object-cover transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.05]${hov ? " group-hover:opacity-0" : ""}">`
      : "";
    const hover = hov
      ? `<img src="/api/images/${hov.id}" width="${hov.width}" height="${hov.height}" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 h-full w-full scale-[1.05] object-cover opacity-0 transition-opacity duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:opacity-100">`
      : "";
    const badge = onSale && p.inStock
      ? `<span class="pill absolute left-3 top-3">−${disc}%</span>`
      : !p.inStock ? `<span class="pill absolute left-3 top-3 !text-charcoal/80">Sold out</span>` : "";
    const priceLine =
      `<span class="text-champagne">${formatINR(p.price)}</span>` +
      (onSale ? `<span class="text-charcoal/40 line-through">${formatINR(p.compareAtPrice!)}</span>` : "");
    const button = p.inStock
      ? `<button type="button" class="add-to-bag btn btn-primary w-full !py-2.5 !text-[0.7rem]" data-slug="${esc(p.slug)}" data-name="${esc(p.name)}" data-price="${p.price}" data-image="${esc(url)}">Add to bag</button>`
      : `<button type="button" class="btn btn-primary w-full !py-2.5 !text-[0.7rem]" disabled>Sold out</button>`;
    return `<article class="shop-card group flex flex-col" data-category="${esc(p.category)}" data-main="${esc(mainOf(p.category, m))}">
      <a href="/product/${encodeURIComponent(p.slug)}" class="block"><div class="card-lux relative overflow-hidden rounded-[3px]" style="aspect-ratio:4 / 5;">${base}${hover}${badge}</div></a>
      <div class="mt-3 flex flex-1 flex-col text-center">
        <p class="text-[10px] uppercase tracking-[0.18em] text-champagne/80">${esc(p.category)}</p>
        <a href="/product/${encodeURIComponent(p.slug)}" class="mt-1 font-serif text-base leading-snug hover:text-ink">${esc(p.name)}</a>
        <p class="mt-1 flex items-baseline justify-center gap-2 text-sm">${priceLine}</p>
        <div class="mt-3">${button}</div>
      </div>
    </article>`;
  }

  function renderPagination(pages: number) {
    if (pages <= 1) { pagination.innerHTML = ""; return; }
    let html = "";
    for (let n = 1; n <= pages; n++)
      html += `<button type="button" class="page-btn" data-page="${n}" data-active="${n === page}">${n}</button>`;
    pagination.innerHTML = html;
  }

  function render() {
    const list = filtered();
    const pages = Math.max(1, Math.ceil(list.length / PER_PAGE));
    if (page > pages) page = 1;
    const startIdx = (page - 1) * PER_PAGE;
    const slice = list.slice(startIdx, startIdx + PER_PAGE);

    // Skip re-rendering the grid on first paint (default view already server-rendered).
    if (!firstPaint) grid.innerHTML = slice.map((p, i) => cardHTML(p, i)).join("");
    firstPaint = false;

    empty.classList.toggle("hidden", list.length > 0);
    resultCount.textContent = list.length
      ? `Showing ${startIdx + 1}–${Math.min(startIdx + PER_PAGE, list.length)} of ${list.length} results`
      : "No results";

    // Sidebar active state + live counts.
    catList.querySelectorAll<HTMLElement>(".cat-link").forEach((b) => {
      b.setAttribute("data-active", String(b.dataset.cat === cat));
    });

    renderPagination(pages);
  }

  // ---- interactions (delegated so they survive re-renders) ----
  catList.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>(".cat-link");
    if (!btn) return;
    cat = btn.dataset.cat || "all";
    page = 1;
    const url = new URL(location.href);
    if (cat === "all") url.searchParams.delete("category");
    else url.searchParams.set("category", cat);
    url.searchParams.delete("sub");
    history.replaceState({}, "", url);
    sidebar.classList.remove("is-open");
    render();
    grid.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  sortSel.addEventListener("change", () => { sort = sortSel.value; page = 1; render(); });

  pagination.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>(".page-btn");
    if (!btn) return;
    page = Number(btn.dataset.page) || 1;
    render();
    grid.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // Add to bag — delegated on the grid, works on server- and client-rendered cards.
  grid.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>(".add-to-bag");
    if (!btn) return;
    e.preventDefault();
    addToCart(
      {
        slug: btn.dataset.slug || "",
        name: btn.dataset.name || "",
        price: Number(btn.dataset.price) || 0,
        image: btn.dataset.image || "",
      },
      1,
    );
    const label = btn.textContent;
    btn.textContent = "Added ✓";
    setTimeout(() => { btn.textContent = label; }, 1400);
  });

  filterToggle?.addEventListener("click", () => sidebar.classList.toggle("is-open"));
  document.getElementById("sidebar-close")?.addEventListener("click", () => sidebar.classList.remove("is-open"));

  // Deep links: ?sub= or ?category= may name a main or a leaf.
  const params = new URLSearchParams(location.search);
  const initialCat = params.get("sub") || params.get("category");
  if (initialCat && data.products.some((p) => p.category === initialCat || mainOf(p.category) === initialCat)) {
    cat = initialCat;
    firstPaint = false; // deep-linked view differs from the server default, so render it
  }
  render();

  // ---- live refresh: pull current data without a rebuild ----
  (async () => {
    try {
      const [pRes, cRes] = await Promise.all([
        fetch("/api/products", { headers: { accept: "application/json" }, cache: "no-store" }),
        fetch("/api/collections", { headers: { accept: "application/json" }, cache: "no-store" }),
      ]);
      if (!pRes.ok || !cRes.ok) return;
      const products = await pRes.json();
      const cats = await cRes.json();
      if (!Array.isArray(products) || !Array.isArray(cats)) return;
      const sig = (d: { products: P[]; cats: C[] }) =>
        JSON.stringify(d.products.map((p) => [p.slug, p.price, p.inStock, p.category, p.images.map((i) => i.id).join(",")]).sort()) +
        JSON.stringify(d.cats.map((c) => [c.name, c.parent, c.position]).sort());
      const next = { products, cats };
      if (sig(next) === sig(data)) return; // nothing changed
      data = next;
      firstPaint = false; // force a fresh render with live data
      render();
    } catch {}
  })();
</script>
