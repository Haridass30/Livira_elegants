---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";

const products = await getCollection("products");
const cats = (await getCollection("categories")).map((c) => c.data);

// Resolve a product's leaf category to its top-level "main":
//  - a direct main → itself
//  - a sub-category → its parent main
//  - unknown (category tree unavailable) → the leaf itself (flat fallback)
const byName = new Map(cats.map((c) => [c.name, c]));
const mainOf = (leaf: string) => {
  const c = byName.get(leaf);
  if (!c) return leaf;
  return c.parent ?? c.name;
};

const productLeaves = new Set(products.map((p) => p.data.category));
const presentMains = new Set(products.map((p) => mainOf(p.data.category)));

// Ordered main categories: known mains (by admin position) that have products,
// then any unknown leaves (flat fallback) alphabetically.
const knownMains = cats
  .filter((c) => !c.parent && presentMains.has(c.name))
  .sort((a, b) => a.position - b.position)
  .map((c) => c.name);
const unknownMains = [...presentMains]
  .filter((n) => !byName.has(n))
  .sort((a, b) => a.localeCompare(b));

const mains = [...knownMains, ...unknownMains].map((name) => {
  // A main shows sub-chips for each child collection that has products.
  const subs = cats
    .filter((s) => s.parent === name && productLeaves.has(s.name))
    .sort((a, b) => a.position - b.position)
    .map((s) => s.name);
  return { name, isGroup: subs.length > 0, subs };
});

// Stable default order: in-stock & featured first, then by name.
products.sort((a, b) => {
  const score = (x: typeof a) =>
    (x.data.inStock ? 0 : 2) + (x.data.featured ? -1 : 0);
  return score(a) - score(b) || a.data.name.localeCompare(b.data.name);
});

const chipClass =
  "filter-btn border hairline px-4 py-2 text-xs uppercase tracking-[0.12em] text-charcoal/70 transition-colors data-[active=true]:border-charcoal data-[active=true]:bg-charcoal data-[active=true]:text-ivory";
const subChipClass =
  "sub-btn border hairline px-3.5 py-1.5 text-[0.7rem] uppercase tracking-[0.1em] text-charcoal/60 transition-colors data-[active=true]:border-champagne data-[active=true]:text-charcoal data-[active=true]:bg-bone";

// Signature of the data this page was built from. On load the client fetches
// live data and compares signatures — it only re-renders the grid/filters when
// something actually changed, so unchanged visits show no flash.
const dataSig = JSON.stringify({
  p: [...products]
    .map((e) => e.data)
    .sort((a, b) => a.slug.localeCompare(b.slug))
    .map((p) => [
      p.slug,
      p.price,
      p.inStock ? 1 : 0,
      p.featured ? 1 : 0,
      p.category,
      (p.images ?? []).map((i) => String(i.url).split("/").pop()).join(","),
    ]),
  c: [...cats]
    .sort((a, b) => a.name.localeCompare(b.name))
    .map((c) => [c.name, c.parent ?? "", c.position]),
});
---

<BaseLayout
  title="Shop"
  description="The full Livira collection — rings, necklaces, earrings and bangles, handcrafted in India."
>
  <section class="container-page py-12 md:py-16">
    <header class="max-w-2xl">
      <p class="eyebrow flex items-center gap-2">
        <span class="gem-mark">◆</span> The collection
      </p>
      <h1 class="mt-3 font-serif text-4xl md:text-5xl">Shop all</h1>
      <p class="mt-4 text-charcoal/65">
        <span id="piece-count">{products.length}</span> pieces, each finished by hand. Filter by category or sort by price.
      </p>
    </header>

    <!-- Controls -->
    <div
      class="mt-10 flex flex-col gap-4 border-y hairline py-4 md:flex-row md:items-center md:justify-between"
    >
      <div id="filter-controls" class="flex flex-col gap-3">
        <div id="main-chips" class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
          <button type="button" data-main="All" class={chipClass}>All</button>
          {
            mains.map((m) => (
              <button type="button" data-main={m.name} class={chipClass}>
                {m.name}
              </button>
            ))
          }
        </div>
        {
          mains
            .filter((m) => m.isGroup)
            .map((m) => (
              <div
                class="sub-row hidden flex-wrap gap-2"
                data-parent={m.name}
                role="group"
                aria-label={`Filter ${m.name} by type`}
              >
                <button type="button" data-sub="" data-parent={m.name} class={subChipClass}>
                  All {m.name}
                </button>
                {m.subs.map((s) => (
                  <button type="button" data-sub={s} data-parent={m.name} class={subChipClass}>
                    {s}
                  </button>
                ))}
              </div>
            ))
        }
      </div>
      <label class="flex items-center gap-3 text-xs uppercase tracking-[0.12em] text-charcoal/60">
        Sort
        <select
          id="sort"
          class="border hairline bg-ivory px-3 py-2 text-charcoal outline-none focus:border-champagne"
        >
          <option value="featured">Featured</option>
          <option value="price-asc">Price: low to high</option>
          <option value="price-desc">Price: high to low</option>
          <option value="name">Name: A–Z</option>
        </select>
      </label>
    </div>

    <!-- Grid -->
    <div
      id="product-grid"
      data-sig={dataSig}
      class="mt-12 grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 md:gap-x-8 lg:grid-cols-4"
    >
      {
        products.map((entry, i) => (
          <div
            class="product-item"
            data-category={entry.data.category}
            data-main={mainOf(entry.data.category)}
            data-price={entry.data.price}
            data-name={entry.data.name}
            data-order={i}
          >
            <ProductCard entry={entry} priority={i < 4} />
          </div>
        ))
      }
    </div>

    <p id="empty-state" class="hidden py-20 text-center text-charcoal/55">
      No pieces in this category yet.
    </p>
  </section>
</BaseLayout>

<script define:vars={{ chipClass, subChipClass }}>
  const grid = document.getElementById("product-grid");
  const controls = document.getElementById("filter-controls");
  const sortSel = document.getElementById("sort");
  const empty = document.getElementById("empty-state");
  const countEl = document.getElementById("piece-count");

  // State refreshed on every (re)init.
  let items = [];
  let mainNames = new Set();
  let catToMain = new Map();
  let activeMain = "All";
  let activeSub = "";

  const fmtINR = new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency: "INR",
    maximumFractionDigits: 0,
  });
  const esc = (s) =>
    String(s ?? "").replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c],
    );

  function apply() {
    let visible = 0;
    for (const el of items) {
      const inMain = activeMain === "All" || el.dataset.main === activeMain;
      const inSub = activeSub === "" || el.dataset.category === activeSub;
      const show = inMain && inSub;
      el.style.display = show ? "" : "none";
      if (show) visible++;
    }
    if (empty) empty.classList.toggle("hidden", visible > 0);

    const sort = sortSel ? sortSel.value : "featured";
    const sorted = [...items].sort((a, b) => {
      const pa = +a.dataset.price,
        pb = +b.dataset.price;
      switch (sort) {
        case "price-asc":
          return pa - pb;
        case "price-desc":
          return pb - pa;
        case "name":
          return a.dataset.name.localeCompare(b.dataset.name);
        default:
          return +a.dataset.order - +b.dataset.order;
      }
    });
    sorted.forEach((el) => grid.appendChild(el));
  }

  function syncChips() {
    controls.querySelectorAll(".filter-btn").forEach((b) =>
      b.setAttribute("data-active", String(b.dataset.main === activeMain)),
    );
    controls.querySelectorAll(".sub-row").forEach((row) => {
      row.classList.toggle("hidden", row.dataset.parent !== activeMain);
      row.classList.toggle("flex", row.dataset.parent === activeMain);
    });
    controls.querySelectorAll(".sub-btn").forEach((b) =>
      b.setAttribute(
        "data-active",
        String(b.dataset.parent === activeMain && (b.dataset.sub ?? "") === activeSub),
      ),
    );
  }

  function setMain(main, sub = "") {
    activeMain = mainNames.has(main) ? main : "All";
    activeSub = sub;
    syncChips();
    const url = new URL(window.location.href);
    url.searchParams.delete("sub");
    if (activeMain === "All") url.searchParams.delete("category");
    else url.searchParams.set("category", activeMain);
    if (activeSub) url.searchParams.set("sub", activeSub);
    history.replaceState({}, "", url);
    apply();
  }

  function setSub(sub) {
    activeSub = sub;
    syncChips();
    const url = new URL(window.location.href);
    if (sub) url.searchParams.set("sub", sub);
    else url.searchParams.delete("sub");
    history.replaceState({}, "", url);
    apply();
  }

  // (Re)query the current DOM, bind chip clicks and honour deep links. Safe to
  // call again after the grid/controls are re-rendered — old nodes (and their
  // listeners) are gone, so nothing double-binds.
  function initShop() {
    items = Array.from(grid.querySelectorAll(".product-item"));
    catToMain = new Map();
    for (const el of items) catToMain.set(el.dataset.category, el.dataset.main);
    const mainBtns = controls.querySelectorAll(".filter-btn");
    mainNames = new Set([...mainBtns].map((b) => b.dataset.main));
    mainBtns.forEach((b) =>
      b.addEventListener("click", () => setMain(b.dataset.main)),
    );
    controls.querySelectorAll(".sub-btn").forEach((b) =>
      b.addEventListener("click", () => setSub(b.dataset.sub ?? "")),
    );

    const params = new URLSearchParams(location.search);
    const subParam = params.get("sub");
    const catParam = params.get("category");
    if (subParam && catToMain.has(subParam)) setMain(catToMain.get(subParam), subParam);
    else if (catParam && mainNames.has(catParam)) setMain(catParam);
    else if (catParam && catToMain.has(catParam)) {
      const m = catToMain.get(catParam);
      setMain(m, m === catParam ? "" : catParam);
    } else setMain("All");
  }

  // Sort <select> is never re-rendered, so bind it once.
  if (sortSel) sortSel.addEventListener("change", apply);
  initShop();

  /* -------- Live refresh: reflect admin changes without a rebuild -------- */
  const mainOfFactory = (cats) => {
    const byName = new Map(cats.map((c) => [c.name, c]));
    return (leaf) => {
      const c = byName.get(leaf);
      return c ? (c.parent ?? c.name) : leaf;
    };
  };

  function sigOf(products, cats) {
    return JSON.stringify({
      p: [...products]
        .sort((a, b) => a.slug.localeCompare(b.slug))
        .map((p) => [
          p.slug,
          p.price,
          p.inStock ? 1 : 0,
          p.featured ? 1 : 0,
          p.category,
          (p.images ?? []).map((i) => String(i.id)).join(","),
        ]),
      c: [...cats]
        .sort((a, b) => a.name.localeCompare(b.name))
        .map((c) => [c.name, c.parent ?? "", c.position]),
    });
  }

  function computeMains(products, cats) {
    const byName = new Map(cats.map((c) => [c.name, c]));
    const mainOf = mainOfFactory(cats);
    const productLeaves = new Set(products.map((p) => p.category));
    const present = new Set(products.map((p) => mainOf(p.category)));
    const known = cats
      .filter((c) => !c.parent && present.has(c.name))
      .sort((a, b) => a.position - b.position)
      .map((c) => c.name);
    const unknown = [...present].filter((n) => !byName.has(n)).sort((a, b) => a.localeCompare(b));
    return [...known, ...unknown].map((name) => {
      const subs = cats
        .filter((s) => s.parent === name && productLeaves.has(s.name))
        .sort((a, b) => a.position - b.position)
        .map((s) => s.name);
      return { name, isGroup: subs.length > 0, subs };
    });
  }

  function itemHTML(p, i, mainOf) {
    const img = p.images && p.images[0];
    const hov = p.images && p.images[1];
    const onSale = p.compareAtPrice && p.compareAtPrice > p.price;
    const disc = onSale ? Math.round(((p.compareAtPrice - p.price) / p.compareAtPrice) * 100) : 0;
    const base = img
      ? `<img src="/api/images/${img.id}" width="${img.width}" height="${img.height}" alt="${esc(p.name)}" loading="${i < 4 ? "eager" : "lazy"}" class="h-full w-full object-cover transition-all duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.05]${hov ? " group-hover:opacity-0" : ""}">`
      : "";
    const hover = hov
      ? `<img src="/api/images/${hov.id}" width="${hov.width}" height="${hov.height}" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 h-full w-full scale-[1.05] object-cover opacity-0 transition-opacity duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:opacity-100">`
      : "";
    const badge =
      onSale && p.inStock
        ? `<span class="pill absolute left-3 top-3">−${disc}%</span>`
        : !p.inStock
          ? `<span class="pill absolute left-3 top-3 !text-charcoal/80">Sold out</span>`
          : "";
    const price =
      `<span class="text-champagne">${fmtINR.format(p.price)}</span>` +
      (onSale ? `<span class="text-charcoal/40 line-through">${fmtINR.format(p.compareAtPrice)}</span>` : "");
    return `<div class="product-item" data-category="${esc(p.category)}" data-main="${esc(mainOf(p.category))}" data-price="${p.price}" data-name="${esc(p.name)}" data-order="${i}">
      <a href="/product/${encodeURIComponent(p.slug)}" class="group block" aria-label="${esc(p.name)}, ${fmtINR.format(p.price)}">
        <div class="card-lux relative overflow-hidden rounded-[3px]" style="aspect-ratio:4 / 5;">
          ${base}${hover}${badge}
          <div class="pointer-events-none absolute inset-x-0 bottom-0 flex justify-center bg-gradient-to-t from-[#150b10]/75 to-transparent pb-4 pt-10 opacity-0 transition-opacity duration-500 group-hover:opacity-100"><span class="text-[11px] uppercase tracking-[0.22em] text-champagne-soft">View piece →</span></div>
        </div>
        <div class="pt-4 text-center">
          <p class="text-[10px] uppercase tracking-[0.2em] text-champagne/70">${esc(p.category)}</p>
          <h3 class="mt-1.5 font-serif text-lg leading-snug transition-colors group-hover:text-ink">${esc(p.name)}</h3>
          <p class="mt-1.5 flex items-baseline justify-center gap-2 text-sm">${price}</p>
        </div>
      </a>
    </div>`;
  }

  function controlsHTML(mains) {
    const mainChips =
      `<button type="button" data-main="All" class="${chipClass}">All</button>` +
      mains.map((m) => `<button type="button" data-main="${esc(m.name)}" class="${chipClass}">${esc(m.name)}</button>`).join("");
    const subRows = mains
      .filter((m) => m.isGroup)
      .map(
        (m) =>
          `<div class="sub-row hidden flex-wrap gap-2" data-parent="${esc(m.name)}" role="group" aria-label="Filter ${esc(m.name)} by type"><button type="button" data-sub="" data-parent="${esc(m.name)}" class="${subChipClass}">All ${esc(m.name)}</button>${m.subs.map((s) => `<button type="button" data-sub="${esc(s)}" data-parent="${esc(m.name)}" class="${subChipClass}">${esc(s)}</button>`).join("")}</div>`,
      )
      .join("");
    return `<div id="main-chips" class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">${mainChips}</div>${subRows}`;
  }

  async function hydrate() {
    try {
      const [pRes, cRes] = await Promise.all([
        fetch("/api/products", { headers: { accept: "application/json" } }),
        fetch("/api/collections", { headers: { accept: "application/json" } }),
      ]);
      if (!pRes.ok || !cRes.ok) return;
      const products = await pRes.json();
      const cats = await cRes.json();
      if (!Array.isArray(products) || !Array.isArray(cats)) return;

      // Skip the re-render entirely when nothing changed (no flash).
      if (sigOf(products, cats) === (grid.dataset.sig ?? "")) return;

      const mainOf = mainOfFactory(cats);
      const mains = computeMains(products, cats);
      const sorted = [...products].sort((a, b) => {
        const score = (x) => (x.inStock ? 0 : 2) + (x.featured ? -1 : 0);
        return score(a) - score(b) || a.name.localeCompare(b.name);
      });

      grid.innerHTML = sorted.map((p, i) => itemHTML(p, i, mainOf)).join("");
      controls.innerHTML = controlsHTML(mains);
      grid.dataset.sig = sigOf(products, cats);
      if (countEl) countEl.textContent = String(products.length);
      initShop();
    } catch (_) {
      /* Network/API hiccup — keep the server-rendered content. */
    }
  }

  hydrate();
</script>
