---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { site } from "../config";
import { getSiteContent } from "../lib/siteContent";
import heroImg from "../assets/hero.jpg";

const { slides, bento } = await getSiteContent();
const multiple = slides.length > 1;
const hasBento = bento.some((b) => b.imageId);
const bentoSig = JSON.stringify(bento.map((b) => [b.imageId ?? 0, b.link, b.caption]));
// Desktop placement: 2 small tiles left, the large tile in the centre, 2 small right.
const BENTO_POS = [
  "md:col-start-2 md:col-span-2 md:row-span-2", // 0 — large centre
  "md:col-start-1 md:row-start-1", // 1 — top-left
  "md:col-start-1 md:row-start-2", // 2 — bottom-left
  "md:col-start-4 md:row-start-1", // 3 — top-right
  "md:col-start-4 md:row-start-2", // 4 — bottom-right
];

const all = await getCollection("products");
// Shop-by tiles use top-level "main" categories (managed from /admin/collections):
// a direct main that has products, or a group main with at least one populated
// sub-category. Falls back to distinct product categories if the tree is empty.
const cats = (await getCollection("categories")).map((c) => c.data);
const productLeaves = new Set(all.map((p) => p.data.category));
const mainCategories = cats
  .filter((c) => !c.parent)
  .sort((a, b) => a.position - b.position)
  // A main tile appears if it (or any of its sub-categories) has products.
  .filter(
    (m) =>
      productLeaves.has(m.name) ||
      cats.some((s) => s.parent === m.name && productLeaves.has(s.name)),
  )
  .map((m) => m.name);
const categories = mainCategories.length
  ? mainCategories
  : [...productLeaves].sort();

const byNameHome = new Map(cats.map((c) => [c.name, c]));
const mainOfHome = (leaf: string) => {
  const c = byNameHome.get(leaf);
  return c ? (c.parent ?? c.name) : leaf;
};

// "Trending" and "New Arrivals" are driven by product tags, matched case- and
// space-insensitively (so "New Arrivals" / "new arrivals" / "newarrivals" match).
const normTag = (s: string) => s.toLowerCase().replace(/\s+/g, "");
const hasTag = (e: (typeof all)[number], tag: string) =>
  (e.data.tags ?? []).some((t) => normTag(t) === normTag(tag));

const trendingProducts = all.filter((e) => hasTag(e, "trending")).slice(0, 12);
const newArrivals = all.filter((e) => hasTag(e, "new arrivals")).slice(0, 12);
const trendingCats = [...new Set(trendingProducts.map((e) => mainOfHome(e.data.category)))];
const tcatClass =
  "tcat border hairline px-4 py-2 text-xs uppercase tracking-[0.12em] text-charcoal/70 transition-colors data-[active=true]:border-charcoal data-[active=true]:bg-charcoal data-[active=true]:text-ivory";

// Brand value props for the trust strip (line-icon medallions).
const values = [
  {
    title: "Easy Returns",
    desc: "Shop with confidence knowing we're here to support you if you need assistance.",
    svg: `<path d="M4 12a8 8 0 1 1 2.5 5.8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M4 8v4h4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    title: "Secure Shipping",
    desc: "Your jewellery is carefully packed and safely delivered to your doorstep.",
    svg: `<path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="7" cy="17" r="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/><circle cx="17.5" cy="17" r="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/>`,
  },
  {
    title: "Premium Quality",
    desc: "Each piece is crafted with attention to detail and a focus on lasting beauty.",
    svg: `<path d="M12 3 4 9l8 12 8-12-8-6Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M4 9h16M9 3l-2 6 5 12M15 3l2 6-5 12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>`,
  },
  {
    title: "Perfect Fit",
    desc: "Designed to be comfortable and suitable for your everyday style.",
    svg: `<circle cx="12" cy="13" r="6" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M9.5 4.5 12 8l2.5-3.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M10 13l1.5 1.5L15 11" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
];

// Signatures of the data this page was built from. The client compares them to
// live data and only re-renders the banner / catalogue sections that changed.
const bannerSig = JSON.stringify(
  slides.map((s) => [
    s.heading, s.subtext, s.buttonLabel, s.buttonLink,
    s.secondaryLabel, s.secondaryLink,
    s.image ? String(s.image.url).split("/").pop() : "",
  ]),
);
const tilesSig = JSON.stringify({
  p: [...all]
    .map((e) => e.data)
    .sort((a, b) => a.slug.localeCompare(b.slug))
    .map((p) => [
      p.slug, p.price, p.inStock ? 1 : 0, p.featured ? 1 : 0, p.category,
      (p.images ?? []).map((i) => String(i.url).split("/").pop()).join(","),
    ]),
  c: [...cats]
    .sort((a, b) => a.name.localeCompare(b.name))
    .map((c) => [c.name, c.parent ?? "", c.position]),
});
const prodSig = (list: typeof all) =>
  JSON.stringify(
    list.map((e) => [
      e.id, e.data.price, e.data.inStock ? 1 : 0, e.data.category,
      (e.data.images ?? []).map((i) => String(i.url).split("/").pop()).join(","),
    ]),
  );
const trendingSig = prodSig(trendingProducts);
const newArrivalsSig = prodSig(newArrivals);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  description: site.statement,
  url: Astro.site?.href,
};
---

<BaseLayout
  title={site.name}
  description={site.statement}
  jsonLd={jsonLd}
>
  <!-- Hero banner slider (one or more admin-editable banners) -->
  <section
    id="hero"
    data-banner-sig={bannerSig}
    class="hero-slider relative h-[46svh] min-h-[290px] overflow-hidden sm:h-[68svh] sm:min-h-[440px] md:h-[88svh] md:min-h-[560px]"
    aria-roledescription="carousel"
    aria-label="Featured banners"
    data-has-hero
  >
    <div class="hero-track flex h-full w-full" id="hero-track">
      {
        slides.map((slide, i) => (
          <div
            class="hero-slide relative flex h-full w-full flex-shrink-0 items-end"
            aria-roledescription="slide"
            aria-label={`Banner ${i + 1} of ${slides.length}`}
          >
            {slide.image ? (
              <img
                src={slide.image.url}
                alt={slide.heading}
                width={slide.image.width}
                height={slide.image.height}
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : "auto"}
                class="absolute inset-0 h-full w-full object-cover"
              />
            ) : (
              <Image
                src={heroImg}
                alt={slide.heading}
                widths={[640, 1024, 1600, 2400]}
                sizes="100vw"
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
                class="absolute inset-0 h-full w-full object-cover"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-[#150b10]/85 via-[#150b10]/30 to-[#150b10]/50" />
            <div class="container-page relative pb-16 md:pb-24">
              <div class="hero-copy">
                <p class="eyebrow flex items-center gap-2">
                  <span class="gem-mark">◆</span> Fine jewellery · India
                </p>
                <h1 class="mt-4 max-w-2xl font-serif text-[2rem] leading-[1.12] sm:text-4xl md:text-5xl lg:text-6xl">
                  <span class="text-metallic is-animated">{slide.heading}</span>
                </h1>
                {slide.subtext && (
                  <p class="mt-5 max-w-md text-ivory/85">{slide.subtext}</p>
                )}
                <div class="mt-8 flex flex-wrap gap-4">
                  <a href={slide.buttonLink} class="btn btn-primary">
                    {slide.buttonLabel}
                  </a>
                  {slide.secondaryLabel && (
                    <a href={slide.secondaryLink} class="btn btn-outline">
                      {slide.secondaryLabel}
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Inset gold frame — a quiet luxury border over the hero. -->
    <div class="pointer-events-none absolute inset-3 z-[5] border hairline md:inset-6"></div>

    {
      multiple && (
        <>
          <button type="button" class="hero-arrow hero-prev" aria-label="Previous banner">
            ‹
          </button>
          <button type="button" class="hero-arrow hero-next" aria-label="Next banner">
            ›
          </button>
          <div class="hero-dots" aria-label="Choose banner">
            {slides.map((_, i) => (
              <button
                type="button"
                class="hero-dot"
                data-dot={i}
                aria-label={`Go to banner ${i + 1}`}
              />
            ))}
          </div>
        </>
      )
    }
  </section>

  <!-- New Arrivals — products tagged "new arrivals" (below the banner) -->
  <section
    id="newarrivals-section"
    class:list={["container-page py-12 md:py-16", newArrivals.length ? "" : "hidden"]}
  >
    <div class="mb-8 flex items-end justify-between">
      <div>
        <p class="eyebrow flex items-center gap-2">
          <span class="gem-mark">◆</span> Just in
        </p>
        <h2 class="mt-2 font-serif text-3xl md:text-4xl">New Arrivals</h2>
      </div>
      <a href="/shop" class="link-underline hidden text-sm uppercase tracking-[0.14em] md:inline">
        View all →
      </a>
    </div>
    <div
      id="newarrivals-grid"
      data-na-sig={newArrivalsSig}
      class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 sm:gap-y-12 md:grid-cols-4 md:gap-x-8"
    >
      {newArrivals.map((entry, i) => <ProductCard entry={entry} priority={i < 4} />)}
    </div>
  </section>

  <!-- Shop-by collections — horizontal scroll of top-level categories -->
  <section class="py-12 md:py-16">
    <div class="container-page mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow flex items-center gap-2">
          <span class="gem-mark">◆</span> Shop by category
        </p>
        <h2 class="mt-2 font-serif text-2xl md:text-3xl">Explore our collections</h2>
        <p class="mt-2 max-w-md text-sm text-charcoal/60">
          Handpicked across every category — swipe to browse and find your perfect piece.
        </p>
      </div>
      <a href="/shop" class="link-underline hidden shrink-0 text-sm uppercase tracking-[0.14em] md:inline">
        View all →
      </a>
    </div>
    <div id="cat-grid" data-tiles-sig={tilesSig} class="cat-scroll grid grid-flow-col grid-rows-2 auto-cols-max snap-x gap-4 overflow-x-auto px-5 pb-3 md:grid-rows-1 md:px-10">
      {
        categories.map((cat) => (
          <a
            href={`/shop?category=${encodeURIComponent(cat)}`}
            class="card-lux group flex aspect-[3/4] w-36 shrink-0 snap-start flex-col items-center justify-center gap-3 overflow-hidden rounded-[3px] px-3 text-center sm:w-40"
          >
            <span class="gem-mark opacity-60 transition-opacity group-hover:opacity-100">◆</span>
            <span class="font-serif text-lg leading-tight tracking-wide sm:text-xl">{cat}</span>
            <span class="gold-rule w-8 transition-all duration-500 group-hover:w-16" />
            <span class="text-[10px] uppercase tracking-[0.18em] text-champagne/70 transition-colors group-hover:text-champagne">
              Explore →
            </span>
          </a>
        ))
      }
      <a
        href={`/shop?category=${encodeURIComponent("Anti-Tarnish Jewels")}`}
        class="card-lux group flex aspect-[3/4] w-36 shrink-0 snap-start flex-col items-center justify-center gap-3 overflow-hidden rounded-[3px] px-3 text-center sm:w-40"
      >
        <span class="gem-mark opacity-60 transition-opacity group-hover:opacity-100">◆</span>
        <span class="font-serif text-base leading-tight tracking-wide sm:text-lg">Anti-Tarnish<br />Jewels</span>
        <span class="gold-rule w-8 transition-all duration-500 group-hover:w-16" />
        <span class="text-[10px] uppercase tracking-[0.18em] text-champagne/70 transition-colors group-hover:text-champagne">
          Explore →
        </span>
      </a>
    </div>
  </section>

  <!-- Bento — admin-uploaded image tiles -->
  <section
    id="bento-section"
    data-bento-sig={bentoSig}
    class:list={["container-page py-12 md:py-16", hasBento ? "" : "hidden"]}
  >
    <div id="bento-grid" class="grid grid-cols-2 gap-3 md:h-[520px] md:grid-cols-4 md:grid-rows-2">
      {
        [0, 1, 2, 3, 4].map((i) => {
          const b = bento[i] ?? { imageId: null, link: "", caption: "" };
          const large = i === 0;
          const cls = `bento-cell group relative block overflow-hidden rounded-[3px] aspect-square md:aspect-auto ${large ? "col-span-2" : ""} ${BENTO_POS[i]} ${b.imageId ? "card-lux" : "surface"}`;
          const Tag = b.imageId && b.link ? "a" : "div";
          return (
            <Tag href={b.imageId && b.link ? b.link : undefined} class={cls}>
              {b.imageId && (
                <img
                  src={`/api/images/${b.imageId}`}
                  alt={b.caption || ""}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
                />
              )}
              {b.imageId && b.caption && (
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#150b10]/70 to-transparent p-4">
                  <span class="font-serif text-lg text-ivory">{b.caption}</span>
                </div>
              )}
            </Tag>
          );
        })
      }
    </div>
  </section>

  <!-- Brand statement -->
  <section class="container-page py-16 text-center md:py-28">
    <p class="eyebrow">The Livira way</p>
    <p
      class="mx-auto mt-6 max-w-3xl font-serif text-xl leading-relaxed text-charcoal sm:text-2xl md:text-[2rem]"
    >
      {site.statement}
    </p>
    <div class="divider-gem mt-10" aria-hidden="true">◆</div>
  </section>

  <!-- Trending — products tagged "trending", filterable by collection -->
  <section
    id="trending-section"
    class:list={["container-page py-6 md:py-10", trendingProducts.length ? "" : "hidden"]}
  >
    <div class="mb-8 text-center">
      <p class="eyebrow flex items-center justify-center gap-2">
        <span class="gem-mark">◆</span> Handpicked
      </p>
      <h2 class="mt-2 font-serif text-3xl md:text-4xl">Trending Now</h2>
    </div>
    <div
      id="trending-tabs"
      class:list={["mb-8 flex-wrap justify-center gap-2", trendingCats.length > 1 ? "flex" : "hidden"]}
    >
      <button type="button" class={tcatClass} data-tcat="all" data-active="true">All</button>
      {trendingCats.map((c) => (
        <button type="button" class={tcatClass} data-tcat={c}>{c}</button>
      ))}
    </div>
    <div
      id="trending-grid"
      data-trending-sig={trendingSig}
      class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 sm:gap-y-12 md:grid-cols-4 md:gap-x-8"
    >
      {trendingProducts.map((entry, i) => (
        <div class="trend-item" data-main={mainOfHome(entry.data.category)}>
          <ProductCard entry={entry} priority={i < 4} />
        </div>
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href="/shop" class="btn btn-outline">View all</a>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-y hairline bg-bone/40">
    <div class="container-page grid grid-cols-2 gap-8 py-14 text-center md:grid-cols-4 md:gap-10 md:py-16">
      {
        values.map((v) => (
          <div class="flex flex-col items-center">
            <span class="icon-medallion" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" set:html={v.svg} />
            </span>
            <h3 class="mt-5 font-serif text-lg md:text-xl">{v.title}</h3>
            <p class="mx-auto mt-2 max-w-xs text-sm text-charcoal/65">{v.desc}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* Horizontal collection scroller — hide the scrollbar for a clean rail. */
  .cat-scroll {
    scrollbar-width: none;
    scroll-padding-left: 1.25rem;
  }
  .cat-scroll::-webkit-scrollbar {
    display: none;
  }

  /* Sliding banner carousel — the track shifts one full width per slide. */
  .hero-track {
    transition: transform 0.7s var(--ease-soft);
    will-change: transform;
  }

  /* Text reveals only for the slide currently on screen. */
  .hero-copy > * {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.7s var(--ease-soft),
      transform 0.7s var(--ease-soft);
  }
  .hero-slide.is-active .hero-copy > * {
    opacity: 1;
    transform: none;
  }
  .hero-copy > *:nth-child(2) {
    transition-delay: 0.08s;
  }
  .hero-copy > *:nth-child(3) {
    transition-delay: 0.16s;
  }
  .hero-copy > *:nth-child(4) {
    transition-delay: 0.24s;
  }

  .hero-arrow {
    position: absolute;
    top: 50%;
    z-index: 10;
    transform: translateY(-50%);
    display: flex;
    height: 46px;
    width: 46px;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-champagne) 32%, transparent);
    border-radius: 999px;
    background: rgba(21, 11, 16, 0.32);
    color: var(--color-champagne-soft);
    font-size: 24px;
    line-height: 1;
    backdrop-filter: blur(4px);
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-soft),
      color 0.3s var(--ease-soft);
  }
  .hero-arrow:hover {
    background: var(--color-champagne);
    color: #241318;
  }
  .hero-prev {
    left: 16px;
  }
  .hero-next {
    right: 16px;
  }
  @media (max-width: 767px) {
    .hero-arrow {
      display: none;
    }
  }

  .hero-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    z-index: 10;
    display: flex;
    transform: translateX(-50%);
    gap: 10px;
  }
  .hero-dot {
    height: 9px;
    width: 9px;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-champagne-soft) 34%, transparent);
    cursor: pointer;
    transition:
      width 0.3s var(--ease-soft),
      background-color 0.3s var(--ease-soft);
  }
  .hero-dot.is-active {
    width: 26px;
    background: var(--color-champagne-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-track {
      transition: none;
    }
    .hero-copy > * {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Homepage: auto-advancing banner carousel + live refresh of the banner,
  // featured products and category tiles — so admin edits appear on refresh
  // without a full site rebuild. The static render is the instant fallback.
  const fmtINR = new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency: "INR",
    maximumFractionDigits: 0,
  });
  const esc = (s) =>
    String(s ?? "").replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c],
    );

  // Idempotent carousel init — safe to re-run after the hero is re-rendered.
  // The timer lives in module scope so a re-init never leaves an old one firing,
  // and handlers use property assignment (`onclick`) so they never stack up.
  let carouselTimer = null;
  function initCarousel() {
    const root = document.querySelector(".hero-slider");
    if (!root) return;
    const track = root.querySelector(".hero-track");
    const slides = [...root.querySelectorAll(".hero-slide")];
    const dots = [...root.querySelectorAll(".hero-dot")];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let i = 0;
    const show = (n) => {
      i = (n + slides.length) % slides.length;
      if (track) track.style.transform = `translateX(-${i * 100}%)`;
      slides.forEach((s, k) => s.classList.toggle("is-active", k === i));
      dots.forEach((d, k) => d.classList.toggle("is-active", k === i));
    };
    const stop = () => {
      if (carouselTimer) {
        clearInterval(carouselTimer);
        carouselTimer = null;
      }
    };
    const start = () => {
      if (reduce || slides.length < 2) return;
      stop();
      carouselTimer = setInterval(() => show(i + 1), 6000);
    };
    const next = root.querySelector(".hero-next");
    const prev = root.querySelector(".hero-prev");
    if (next) next.onclick = () => { show(i + 1); start(); };
    if (prev) prev.onclick = () => { show(i - 1); start(); };
    dots.forEach((d, k) => { d.onclick = () => { show(k); start(); }; });
    root.onmouseenter = stop;
    root.onmouseleave = start;

    // Touch swipe (mobile) — drag left/right to change banner.
    let startX = 0, dx = 0, dragging = false;
    root.ontouchstart = (e) => { startX = e.touches[0].clientX; dx = 0; dragging = true; stop(); };
    root.ontouchmove = (e) => { if (dragging) dx = e.touches[0].clientX - startX; };
    root.ontouchend = () => {
      if (!dragging) return;
      dragging = false;
      if (Math.abs(dx) > 40) show(dx < 0 ? i + 1 : i - 1);
      dx = 0;
      start();
    };

    show(0);
    start();
  }
  initCarousel();

  // The bundled default hero image (used for slides with no uploaded photo).
  const firstImg = document.querySelector(".hero-slide img");
  const defaultHeroSrc = firstImg ? firstImg.getAttribute("src") : "";

  /* ---------- renderers (mirror the Astro markup above) ---------- */
  function heroSlideHTML(s, i, total) {
    const hasImg = s.imageId && s.imageWidth && s.imageHeight;
    const src = hasImg ? `/api/images/${s.imageId}` : defaultHeroSrc;
    const w = hasImg ? s.imageWidth : 2400;
    const h = hasImg ? s.imageHeight : 1600;
    const img = src
      ? `<img src="${esc(src)}" alt="${esc(s.heading)}" width="${w}" height="${h}" loading="${i === 0 ? "eager" : "lazy"}" fetchpriority="${i === 0 ? "high" : "auto"}" class="absolute inset-0 h-full w-full object-cover">`
      : "";
    const sub = s.subtext ? `<p class="mt-5 max-w-md text-ivory/85">${esc(s.subtext)}</p>` : "";
    const secondary = s.secondaryLabel
      ? `<a href="${esc(s.secondaryLink)}" class="btn btn-outline">${esc(s.secondaryLabel)}</a>`
      : "";
    return `<div class="hero-slide relative flex h-full w-full flex-shrink-0 items-end" aria-roledescription="slide" aria-label="Banner ${i + 1} of ${total}">${img}<div class="absolute inset-0 bg-gradient-to-t from-[#150b10]/85 via-[#150b10]/30 to-[#150b10]/50"></div><div class="container-page relative pb-16 md:pb-24"><div class="hero-copy"><p class="eyebrow flex items-center gap-2"><span class="gem-mark">◆</span> Fine jewellery · India</p><h1 class="mt-4 max-w-2xl font-serif text-4xl leading-[1.08] md:text-6xl"><span class="text-metallic is-animated">${esc(s.heading)}</span></h1>${sub}<div class="mt-8 flex flex-wrap gap-4"><a href="${esc(s.buttonLink)}" class="btn btn-primary">${esc(s.buttonLabel)}</a>${secondary}</div></div></div></div>`;
  }
  function heroHTML(slides) {
    const total = slides.length;
    const track = `<div class="hero-track flex h-full w-full" id="hero-track">${slides.map((s, i) => heroSlideHTML(s, i, total)).join("")}</div>`;
    const frame = `<div class="pointer-events-none absolute inset-3 z-[5] border hairline md:inset-6"></div>`;
    let controls = "";
    if (total > 1) {
      const dots = slides.map((_, i) => `<button type="button" class="hero-dot" data-dot="${i}" aria-label="Go to banner ${i + 1}"></button>`).join("");
      controls = `<button type="button" class="hero-arrow hero-prev" aria-label="Previous banner">‹</button><button type="button" class="hero-arrow hero-next" aria-label="Next banner">›</button><div class="hero-dots" aria-label="Choose banner">${dots}</div>`;
    }
    return track + frame + controls;
  }

  function cardHTML(p, priority) {
    const img = p.images && p.images[0];
    const hov = p.images && p.images[1];
    const onSale = p.compareAtPrice && p.compareAtPrice > p.price;
    const disc = onSale ? Math.round(((p.compareAtPrice - p.price) / p.compareAtPrice) * 100) : 0;
    const base = img
      ? `<img src="/api/images/${img.id}" width="${img.width}" height="${img.height}" alt="${esc(p.name)}" loading="${priority ? "eager" : "lazy"}" class="h-full w-full object-cover transition-all duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.05]${hov ? " group-hover:opacity-0" : ""}">`
      : "";
    const hover = hov
      ? `<img src="/api/images/${hov.id}" width="${hov.width}" height="${hov.height}" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 h-full w-full scale-[1.05] object-cover opacity-0 transition-opacity duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:opacity-100">`
      : "";
    const badge =
      onSale && p.inStock
        ? `<span class="pill absolute left-3 top-3">−${disc}%</span>`
        : !p.inStock
          ? `<span class="pill absolute left-3 top-3 !text-charcoal/80">Sold out</span>`
          : "";
    const price =
      `<span class="text-champagne">${fmtINR.format(p.price)}</span>` +
      (onSale ? `<span class="text-charcoal/40 line-through">${fmtINR.format(p.compareAtPrice)}</span>` : "");
    return `<a href="/product/${encodeURIComponent(p.slug)}" class="group block" aria-label="${esc(p.name)}, ${fmtINR.format(p.price)}"><div class="card-lux relative overflow-hidden rounded-[3px]" style="aspect-ratio:4 / 5;">${base}${hover}${badge}<div class="pointer-events-none absolute inset-x-0 bottom-0 flex justify-center bg-gradient-to-t from-[#150b10]/75 to-transparent pb-4 pt-10 opacity-0 transition-opacity duration-500 group-hover:opacity-100"><span class="text-[11px] uppercase tracking-[0.22em] text-champagne-soft">View piece →</span></div></div><div class="pt-4 text-center"><p class="text-[10px] uppercase tracking-[0.2em] text-champagne/70">${esc(p.category)}</p><h3 class="mt-1.5 font-serif text-lg leading-snug transition-colors group-hover:text-ink">${esc(p.name)}</h3><p class="mt-1.5 flex items-baseline justify-center gap-2 text-sm">${price}</p></div></a>`;
  }

  const tileClass = "card-lux group flex aspect-[3/4] w-36 shrink-0 snap-start flex-col items-center justify-center gap-3 overflow-hidden rounded-[3px] px-3 text-center sm:w-40";
  function tileHTML(name) {
    return `<a href="/shop?category=${encodeURIComponent(name)}" class="${tileClass}"><span class="gem-mark opacity-60 transition-opacity group-hover:opacity-100">◆</span><span class="font-serif text-lg leading-tight tracking-wide sm:text-xl">${esc(name)}</span><span class="gold-rule w-8 transition-all duration-500 group-hover:w-16"></span><span class="text-[10px] uppercase tracking-[0.18em] text-champagne/70 transition-colors group-hover:text-champagne">Explore →</span></a>`;
  }
  const antiTarnishTile = `<a href="/shop?category=${encodeURIComponent("Anti-Tarnish Jewels")}" class="${tileClass}"><span class="gem-mark opacity-60 transition-opacity group-hover:opacity-100">◆</span><span class="font-serif text-base leading-tight tracking-wide sm:text-lg">Anti-Tarnish<br>Jewels</span><span class="gold-rule w-8 transition-all duration-500 group-hover:w-16"></span><span class="text-[10px] uppercase tracking-[0.18em] text-champagne/70 transition-colors group-hover:text-champagne">Explore →</span></a>`;

  function presentMains(products, cats) {
    const leaves = new Set(products.map((p) => p.category));
    const mains = cats
      .filter((c) => !c.parent)
      .sort((a, b) => a.position - b.position)
      .filter((m) => leaves.has(m.name) || cats.some((s) => s.parent === m.name && leaves.has(s.name)))
      .map((m) => m.name);
    return mains.length ? mains : [...leaves].sort();
  }

  /* ---------- live refresh ---------- */
  // ---- trending helpers ----
  const TCAT = "tcat border hairline px-4 py-2 text-xs uppercase tracking-[0.12em] text-charcoal/70 transition-colors data-[active=true]:border-charcoal data-[active=true]:bg-charcoal data-[active=true]:text-ivory";
  const tTabs = document.getElementById("trending-tabs");
  const tGrid = document.getElementById("trending-grid");
  function applyTrendFilter(tc) {
    tTabs?.querySelectorAll(".tcat").forEach((b) =>
      b.setAttribute("data-active", String(b.dataset.tcat === tc)),
    );
    tGrid?.querySelectorAll(".trend-item").forEach((el) => {
      el.style.display = tc === "all" || el.dataset.main === tc ? "" : "none";
    });
  }
  tTabs?.addEventListener("click", (e) => {
    const b = e.target.closest(".tcat");
    if (b) applyTrendFilter(b.dataset.tcat);
  });
  function trendItemHTML(p, i, mainOf) {
    return `<div class="trend-item" data-main="${esc(mainOf(p.category))}">${cardHTML(p, i < 4)}</div>`;
  }
  const BENTO_POS = [
    "md:col-start-2 md:col-span-2 md:row-span-2",
    "md:col-start-1 md:row-start-1",
    "md:col-start-1 md:row-start-2",
    "md:col-start-4 md:row-start-1",
    "md:col-start-4 md:row-start-2",
  ];
  function bentoCellHTML(b, i) {
    const large = i === 0;
    const cls = `bento-cell group relative block overflow-hidden rounded-[3px] aspect-square md:aspect-auto ${large ? "col-span-2" : ""} ${BENTO_POS[i]} ${b.imageId ? "card-lux" : "surface"}`;
    const img = b.imageId
      ? `<img src="/api/images/${b.imageId}" alt="${esc(b.caption || "")}" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105">`
      : "";
    const cap = b.imageId && b.caption
      ? `<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#150b10]/70 to-transparent p-4"><span class="font-serif text-lg text-ivory">${esc(b.caption)}</span></div>`
      : "";
    const tag = b.imageId && b.link ? "a" : "div";
    const href = b.imageId && b.link ? ` href="${esc(b.link)}"` : "";
    return `<${tag}${href} class="${cls}">${img}${cap}</${tag}>`;
  }

  async function hydrate() {
    try {
      const [cRes, pRes, colRes] = await Promise.all([
        fetch("/api/content", { headers: { accept: "application/json" }, cache: "no-store" }),
        fetch("/api/products", { headers: { accept: "application/json" }, cache: "no-store" }),
        fetch("/api/collections", { headers: { accept: "application/json" }, cache: "no-store" }),
      ]);
      if (!cRes.ok || !pRes.ok || !colRes.ok) return;
      const content = await cRes.json();
      const products = await pRes.json();
      const cats = await colRes.json();
      const slides =
        Array.isArray(content.slides) && content.slides.length
          ? content.slides
          : content.hero
            ? [content.hero]
            : [];
      if (!Array.isArray(products) || !Array.isArray(cats)) return;

      // Banner — re-render only when the banner data changed.
      const hero = document.getElementById("hero");
      if (hero && slides.length) {
        const bSig = JSON.stringify(
          slides.map((s) => [
            s.heading, s.subtext, s.buttonLabel, s.buttonLink,
            s.secondaryLabel, s.secondaryLink, s.imageId ? String(s.imageId) : "",
          ]),
        );
        if (bSig !== (hero.dataset.bannerSig ?? "")) {
          hero.innerHTML = heroHTML(slides);
          hero.dataset.bannerSig = bSig;
          initCarousel();
        }
      }

      const normTag = (s) => String(s ?? "").toLowerCase().replace(/\s+/g, "");
      const hasTag = (p, tag) => (p.tags ?? []).some((t) => normTag(t) === normTag(tag));
      const prodSig = (list) =>
        JSON.stringify(list.map((p) => [p.slug, p.price, p.inStock ? 1 : 0, p.category, (p.images ?? []).map((i) => String(i.id)).join(",")]));
      const bn = new Map(cats.map((c) => [c.name, c]));
      const mainOf = (leaf) => { const c = bn.get(leaf); return c ? (c.parent ?? c.name) : leaf; };

      // Category tiles — re-render only when the catalogue changed.
      const tiles = document.getElementById("cat-grid");
      const tilesSigVal = JSON.stringify({
        p: [...products]
          .sort((a, b) => a.slug.localeCompare(b.slug))
          .map((p) => [p.slug, p.price, p.inStock ? 1 : 0, p.featured ? 1 : 0, p.category, (p.images ?? []).map((i) => String(i.id)).join(",")]),
        c: [...cats].sort((a, b) => a.name.localeCompare(b.name)).map((c) => [c.name, c.parent ?? "", c.position]),
      });
      if (tiles && tilesSigVal !== (tiles.dataset.tilesSig ?? "")) {
        tiles.innerHTML = presentMains(products, cats).map(tileHTML).join("") + antiTarnishTile;
        tiles.dataset.tilesSig = tilesSigVal;
      }

      // Trending (tag "trending") — with collection filter tabs.
      if (tGrid) {
        const tprods = products.filter((p) => hasTag(p, "trending")).slice(0, 12);
        const tSig = prodSig(tprods);
        if (tSig !== (tGrid.dataset.trendingSig ?? "")) {
          const tcats = [...new Set(tprods.map((p) => mainOf(p.category)))];
          tGrid.innerHTML = tprods.map((p, i) => trendItemHTML(p, i, mainOf)).join("");
          tGrid.dataset.trendingSig = tSig;
          document.getElementById("trending-section")?.classList.toggle("hidden", tprods.length === 0);
          if (tTabs) {
            tTabs.innerHTML =
              `<button type="button" class="${TCAT}" data-tcat="all" data-active="true">All</button>` +
              tcats.map((c) => `<button type="button" class="${TCAT}" data-tcat="${esc(c)}">${esc(c)}</button>`).join("");
            tTabs.classList.toggle("hidden", tcats.length <= 1);
            tTabs.classList.toggle("flex", tcats.length > 1);
            applyTrendFilter("all");
          }
        }
      }

      // New Arrivals (tag "new arrivals").
      const naGrid = document.getElementById("newarrivals-grid");
      if (naGrid) {
        const na = products.filter((p) => hasTag(p, "new arrivals")).slice(0, 12);
        const naSig = prodSig(na);
        if (naSig !== (naGrid.dataset.naSig ?? "")) {
          naGrid.innerHTML = na.map((p, i) => cardHTML(p, i < 4)).join("");
          naGrid.dataset.naSig = naSig;
          document.getElementById("newarrivals-section")?.classList.toggle("hidden", na.length === 0);
        }
      }

      // Bento tiles.
      const bentoSec = document.getElementById("bento-section");
      const bentoGrid = document.getElementById("bento-grid");
      if (bentoSec && bentoGrid) {
        const boxes = (Array.isArray(content.bento) ? content.bento : []).slice(0, 5).map((b) => ({
          imageId: Number.isInteger(Number(b?.imageId)) && Number(b?.imageId) > 0 ? Number(b.imageId) : null,
          link: typeof b?.link === "string" ? b.link : "",
          caption: typeof b?.caption === "string" ? b.caption : "",
        }));
        const bSig = JSON.stringify(boxes.map((b) => [b.imageId ?? 0, b.link, b.caption]));
        if (bSig !== (bentoSec.dataset.bentoSig ?? "")) {
          bentoGrid.innerHTML = [0, 1, 2, 3, 4].map((i) => bentoCellHTML(boxes[i] ?? { imageId: null, link: "", caption: "" }, i)).join("");
          bentoSec.dataset.bentoSig = bSig;
          bentoSec.classList.toggle("hidden", !boxes.some((b) => b.imageId));
        }
      }
    } catch (_) {
      /* Network/API hiccup — keep the server-rendered homepage. */
    }
  }
  hydrate();
</script>
