---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatINR } from "../lib/format";

/**
 * Editorial product card — the home page's frameless variant: no card border,
 * a light sweep across the photo on hover, and the material as the eyebrow.
 *
 * The framed boutique card used everywhere else lives in ProductCard.astro;
 * the two are deliberately separate so restyling the home page cannot change
 * /shop or the product pages.
 */
interface Props {
  entry: CollectionEntry<"products">;
  /** Eager-load the first row above the fold; lazy-load the rest. */
  priority?: boolean;
  class?: string;
}

const { entry, priority = false, class: className = "" } = Astro.props;
const p = entry.data;
const onSale = p.compareAtPrice && p.compareAtPrice > p.price;
const discount = onSale
  ? Math.round(((p.compareAtPrice! - p.price) / p.compareAtPrice!) * 100)
  : 0;
// A second photo cross-fades in on hover.
const hover = p.images[1];
const sizes = "(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 72vw";
---

<a
  href={`/product/${entry.id}`}
  class:list={["group block", className]}
  aria-label={`${p.name}, ${formatINR(p.price)}`}
>
  <div class="sheen-on-hover relative overflow-hidden bg-bone">
    <div
      class="transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06]"
    >
      {
        p.images[0] ? (
          <Image
            src={p.images[0].url}
            width={p.images[0].width}
            height={p.images[0].height}
            alt={p.name}
            widths={[280, 420, 640, 900]}
            sizes={sizes}
            loading={priority ? "eager" : "lazy"}
            fetchpriority={priority ? "high" : "auto"}
            class="aspect-[4/5] w-full object-cover"
          />
        ) : (
          <div class="aspect-[4/5] w-full bg-sand" />
        )
      }
    </div>
    {
      hover && (
        <div class="absolute inset-0 opacity-0 transition-opacity duration-700 group-hover:opacity-100">
          <Image
            src={hover.url}
            width={hover.width}
            height={hover.height}
            alt=""
            aria-hidden="true"
            widths={[280, 420, 640, 900]}
            sizes={sizes}
            loading="lazy"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
      )
    }

    <!-- Badge bar, top-left -->
    {
      onSale && p.inStock && (
        <span class="eyebrow absolute left-0 top-4 z-10 bg-ink/90 px-3 py-1.5 text-ivory">
          −{discount}%
        </span>
      )
    }
    {
      !p.inStock && (
        <span class="eyebrow absolute left-0 top-4 z-10 bg-ink/90 px-3 py-1.5 text-ivory">
          Sold out
        </span>
      )
    }
  </div>

  <div class="pt-4">
    <p class="eyebrow !text-taupe">{p.material}</p>
    <h3
      class="mt-1.5 font-serif text-lg leading-snug text-ink transition-colors duration-500 group-hover:text-champagne"
    >
      {p.name}
    </h3>
    <p class="mt-1 flex items-baseline gap-2 text-sm text-charcoal">
      <span class="text-champagne">{formatINR(p.price)}</span>
      {
        onSale && (
          <span class="text-taupe/70 line-through">{formatINR(p.compareAtPrice!)}</span>
        )
      }
    </p>
  </div>
</a>
