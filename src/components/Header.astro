---
import { Image } from "astro:assets";
import { site, nav } from "../config";
import CartButton from "./react/CartButton.tsx";
import logo from "../assets/brand/logo-header.png";
import { getSiteContent } from "../lib/siteContent";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

// The announcement bar (h-9 = 2.25rem) sits above; header stacks below it.
const hasBar = (await getSiteContent()).announcements.length > 0;
---

<header
  id="site-header"
  class:list={[
    "fixed inset-x-0 z-40 border-b hairline bg-ivory/95 backdrop-blur",
    hasBar ? "top-9" : "top-0",
  ]}
>
  <div class="container-page flex h-16 items-center justify-between md:h-20">
    <!-- Left: mobile menu toggle + desktop nav -->
    <div class="flex items-center gap-9">
      <button
        type="button"
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="flex h-10 w-10 items-center justify-center text-charcoal/80 md:hidden"
      >
        <span class="sr-only">Menu</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </button>

      <nav class="hidden items-center gap-9 md:flex" aria-label="Primary">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "link-underline text-[0.78rem] uppercase tracking-[0.16em]",
                isActive(item.href) ? "text-champagne" : "text-charcoal/80 hover:text-charcoal",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <!-- Brand logo, centered -->
    <a
      href="/"
      class="absolute left-1/2 -translate-x-1/2"
      aria-label={`${site.name} — home`}
    >
      <Image
        src={logo}
        alt={site.name}
        widths={[96, 130, 180]}
        sizes="(min-width: 768px) 62px, 48px"
        loading="eager"
        class="h-[48px] w-auto md:h-[62px]"
      />
    </a>

    <!-- Right: search + account + cart -->
    <div class="flex items-center gap-1">
      <button
        type="button"
        id="search-toggle"
        aria-label="Search"
        aria-expanded="false"
        aria-controls="search-panel"
        class="flex h-10 w-10 items-center justify-center text-charcoal/80 hover:text-charcoal"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5" />
          <path d="m20 20-3.2-3.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
      <a
        href="/account"
        aria-label="My account"
        class="flex h-10 w-10 items-center justify-center text-charcoal/80 hover:text-charcoal"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.5" />
          <path d="M5 20a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </a>
      <CartButton client:load />
    </div>
  </div>

  <!-- Search panel -->
  <div id="search-panel" class="hidden border-t hairline bg-ivory">
    <div class="container-page py-4">
      <form id="search-form" role="search" onsubmit="return false">
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-charcoal/40" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5" />
            <path d="m20 20-3.2-3.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <input
            id="search-input"
            type="search"
            autocomplete="off"
            placeholder="Search jewellery — name, type, material…"
            class="w-full border hairline bg-ivory py-3 pl-11 pr-4 text-charcoal outline-none focus:border-champagne"
          />
        </div>
      </form>
      <div id="search-results" class="mt-3 max-h-[60vh] overflow-y-auto"></div>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <div id="mobile-nav" class="hidden border-t hairline bg-ivory md:hidden">
    <nav class="container-page flex flex-col py-4" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "py-3 text-sm uppercase tracking-[0.16em]",
              isActive(item.href) ? "text-champagne" : "text-charcoal/80",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/account" class="border-t hairline py-3 text-sm uppercase tracking-[0.16em] text-charcoal/80">
        My account
      </a>
    </nav>
  </div>
</header>

<script>
  import { formatINR } from "../lib/format";

  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const open = panel?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  // ---- Search ----
  const sToggle = document.getElementById("search-toggle");
  const sPanel = document.getElementById("search-panel");
  const sInput = document.getElementById("search-input") as HTMLInputElement | null;
  const sResults = document.getElementById("search-results");

  type SP = {
    slug: string; name: string; price: number; category: string;
    material?: string; sku?: string | null; description?: string;
    tags?: string[]; inStock?: boolean;
    images: { id: number }[];
  };
  let catalogue: SP[] | null = null;
  let loading = false;

  async function ensureCatalogue() {
    if (catalogue || loading) return;
    loading = true;
    try {
      const res = await fetch("/api/products", {
        headers: { accept: "application/json" },
        cache: "no-store",
      });
      if (res.ok) catalogue = await res.json();
    } catch {
      /* leave null; search shows a gentle message */
    } finally {
      loading = false;
    }
  }

  function haystack(p: SP) {
    return [
      p.name, p.category, p.material ?? "", p.sku ?? "",
      (p.tags ?? []).join(" "), p.description ?? "",
    ].join(" ").toLowerCase();
  }

  function renderResults(q: string) {
    if (!sResults) return;
    const query = q.trim().toLowerCase();
    if (!query) { sResults.innerHTML = ""; return; }
    if (!catalogue) {
      sResults.innerHTML = `<p class="py-6 text-center text-sm text-charcoal/50">Loading…</p>`;
      return;
    }
    const terms = query.split(/\s+/);
    const hits = catalogue
      .filter((p) => { const h = haystack(p); return terms.every((t) => h.includes(t)); })
      .slice(0, 8);
    if (!hits.length) {
      sResults.innerHTML = `<p class="py-6 text-center text-sm text-charcoal/50">No matches for “${query.replace(/</g, "")}”.</p>`;
      return;
    }
    sResults.innerHTML = hits
      .map((p) => {
        const img = p.images && p.images[0];
        const thumb = img ? `/api/images/${img.id}` : "";
        return `<a href="/product/${encodeURIComponent(p.slug)}" class="flex items-center gap-4 border-b hairline py-3 last:border-0 hover:bg-bone/60">
          <img src="${thumb}" alt="" width="48" height="60" class="h-14 w-11 shrink-0 rounded-[2px] object-cover" loading="lazy">
          <span class="flex-1"><span class="block text-[10px] uppercase tracking-[0.16em] text-champagne/80">${p.category}</span><span class="block font-serif">${p.name}</span></span>
          <span class="text-sm text-charcoal/70">${formatINR(p.price)}</span>
        </a>`;
      })
      .join("");
  }

  function openSearch() {
    sPanel?.classList.remove("hidden");
    sToggle?.setAttribute("aria-expanded", "true");
    ensureCatalogue().then(() => renderResults(sInput?.value ?? ""));
    setTimeout(() => sInput?.focus(), 30);
  }
  function closeSearch() {
    sPanel?.classList.add("hidden");
    sToggle?.setAttribute("aria-expanded", "false");
  }

  sToggle?.addEventListener("click", () => {
    if (sPanel?.classList.contains("hidden")) openSearch();
    else closeSearch();
  });

  let t: ReturnType<typeof setTimeout>;
  sInput?.addEventListener("input", () => {
    clearTimeout(t);
    t = setTimeout(() => renderResults(sInput.value), 140);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeSearch();
  });
</script>
